# GridShare configuration (prefix GS_)
GS_ENVIRONMENT=local
GS_N_HOUSES=20
GS_GRID_BUY_CENTS=80         # price (cents/kWh) to buy from the grid
GS_GRID_SELL_CENTS=20        # price (cents/kWh) the grid pays for exports (feed-in)
GS_CHAIN_ENABLED=true
GS_CHAIN_RPC_URL=http://anvil:8545
GS_CONTRACT_ADDRESS=
